rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminRef() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function hasAdminDocument() {
      return isSignedIn() && exists(adminRef());
    }

    function adminData() {
      return get(adminRef()).data;
    }

    function isActiveAdmin() {
      return hasAdminDocument()
        && adminData().status == "active"
        && adminData().role in ["super_admin", "admin", "editor"];
    }

    function isManagerAdmin() {
      return hasAdminDocument()
        && adminData().status == "active"
        && adminData().role in ["super_admin", "admin"];
    }

    function isSuperAdmin() {
      return hasAdminDocument()
        && adminData().status == "active"
        && adminData().role == "super_admin";
    }

    function validAdminDocument(adminId) {
      return request.resource.data.keys().hasAll([
        "uid",
        "email",
        "displayName",
        "role",
        "status"
      ])
      && request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "displayName",
        "role",
        "status",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ])

      && request.resource.data.uid is string
      && request.resource.data.uid == adminId

      && request.resource.data.email is string
      && request.resource.data.email.size() > 3
      && request.resource.data.email.size() <= 254

      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() > 0
      && request.resource.data.displayName.size() <= 100

      && request.resource.data.role in ["super_admin", "admin", "editor"]
      && request.resource.data.status in ["active", "passive"]

      && (
        !("createdAt" in request.resource.data)
        || (
          request.resource.data.createdAt is string
          && request.resource.data.createdAt.size() <= 40
        )
      )

      && (
        !("updatedAt" in request.resource.data)
        || (
          request.resource.data.updatedAt is string
          && request.resource.data.updatedAt.size() <= 40
        )
      )

      && (
        !("lastLoginAt" in request.resource.data)
        || (
          request.resource.data.lastLoginAt is string
          && request.resource.data.lastLoginAt.size() <= 40
        )
      );
    }

    function validContactMessageCreate() {
      let data = request.resource.data;

      return data.keys().hasAll([
        "fullName",
        "phone",
        "subject",
        "message",
        "status",
        "createdAt",
        "updatedAt"
      ])

      && data.keys().hasOnly([
        "fullName",
        "phone",
        "email",
        "subject",
        "message",
        "status",
        "customerUid",
        "customerOnline",
        "lastCustomerSeenAt",
        "adminNotified",
        "lastMessage",
        "lastMessageAt",
        "lastSender",
        "sourcePage",
        "userAgent",
        "createdAt",
        "updatedAt"
      ])

      && data.fullName is string
      && data.fullName.size() >= 2
      && data.fullName.size() <= 100

      && data.phone is string
      && data.phone.size() >= 7
      && data.phone.size() <= 30

      && (
        !("email" in data)
        || (
          data.email is string
          && data.email.size() <= 160
        )
      )

      && data.subject is string
      && data.subject.size() > 0
      && data.subject.size() <= 150

      && data.message is string
      && data.message.size() > 0
      && data.message.size() <= 3000

      && data.status in ["new", "read", "answered", "replied"]

      && (
        !("customerUid" in data)
        || (
          data.customerUid is string
          && isSignedIn()
          && data.customerUid == request.auth.uid
        )
      )

      && (
        !("customerOnline" in data)
        || data.customerOnline is bool
      )

      && (
        !("lastCustomerSeenAt" in data)
        || (
          data.lastCustomerSeenAt is string
          || data.lastCustomerSeenAt is timestamp
        )
      )

      && (
        !("adminNotified" in data)
        || data.adminNotified is bool
      )

      && (
        !("lastMessage" in data)
        || (
          data.lastMessage is string
          && data.lastMessage.size() <= 3000
        )
      )

      && (
        !("lastMessageAt" in data)
        || (
          data.lastMessageAt is string
          || data.lastMessageAt is timestamp
        )
      )

      && (
        !("lastSender" in data)
        || data.lastSender in ["customer", "admin"]
      )

      && (
        !("sourcePage" in data)
        || (
          data.sourcePage is string
          && data.sourcePage.size() <= 200
        )
      )

      && (
        !("userAgent" in data)
        || (
          data.userAgent is string
          && data.userAgent.size() <= 500
        )
      )

      && (
        data.createdAt is string
        || data.createdAt is timestamp
      )

      && (
        !(data.createdAt is string)
        || data.createdAt.size() <= 40
      )

      && (
        data.updatedAt is string
        || data.updatedAt is timestamp
      )

      && (
        !(data.updatedAt is string)
        || data.updatedAt.size() <= 40
      );
    }

    function validContactMessageAdminUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "status",
          "updatedAt",
          "adminReply",
          "repliedAt",
          "lastMessage",
          "lastMessageAt",
          "lastSender",
          "customerOnline",
          "lastCustomerSeenAt",
          "adminNotified"
        ])

      && request.resource.data.status in ["new", "read", "answered", "replied"]

      && (
        !("adminReply" in request.resource.data)
        || (
          request.resource.data.adminReply is string
          && request.resource.data.adminReply.size() <= 2000
        )
      )

      && (
        !("repliedAt" in request.resource.data)
        || (
          request.resource.data.repliedAt is string
          || request.resource.data.repliedAt is timestamp
        )
      )

      && (
        !("repliedAt" in request.resource.data)
        || !(request.resource.data.repliedAt is string)
        || request.resource.data.repliedAt.size() <= 40
      )

      && (
        !("lastMessage" in request.resource.data)
        || (
          request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 3000
        )
      )

      && (
        !("lastMessageAt" in request.resource.data)
        || (
          request.resource.data.lastMessageAt is string
          || request.resource.data.lastMessageAt is timestamp
        )
      )

      && (
        !("lastSender" in request.resource.data)
        || request.resource.data.lastSender in ["customer", "admin"]
      )

      && (
        !("customerOnline" in request.resource.data)
        || request.resource.data.customerOnline is bool
      )

      && (
        !("lastCustomerSeenAt" in request.resource.data)
        || (
          request.resource.data.lastCustomerSeenAt is string
          || request.resource.data.lastCustomerSeenAt is timestamp
        )
      )

      && (
        !("adminNotified" in request.resource.data)
        || request.resource.data.adminNotified is bool
      )

      && (
        request.resource.data.status != "replied"
        && request.resource.data.status != "answered"
        || (
          request.resource.data.adminReply is string
          && request.resource.data.adminReply.size() > 0
          && (
            request.resource.data.repliedAt is string
            || request.resource.data.repliedAt is timestamp
          )
        )
      )

      && (
        request.resource.data.updatedAt is string
        || request.resource.data.updatedAt is timestamp
      )

      && (
        !(request.resource.data.updatedAt is string)
        || request.resource.data.updatedAt.size() <= 40
      );
    }

    function validContactMessageCustomerUpdate() {
      return isSignedIn()
      && resource.data.customerUid is string
      && resource.data.customerUid == request.auth.uid
      && request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "customerOnline",
          "lastCustomerSeenAt",
          "lastMessage",
          "lastMessageAt",
          "lastSender",
          "status",
          "updatedAt",
          "adminNotified",
          "fullName",
          "phone",
          "email"
        ])

      && request.resource.data.status in ["new", "read", "answered", "replied"]

      && (
        !("customerOnline" in request.resource.data)
        || request.resource.data.customerOnline is bool
      )

      && (
        !("lastCustomerSeenAt" in request.resource.data)
        || (
          request.resource.data.lastCustomerSeenAt is string
          || request.resource.data.lastCustomerSeenAt is timestamp
        )
      )

      && (
        !("lastMessage" in request.resource.data)
        || (
          request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 3000
        )
      )

      && (
        !("lastMessageAt" in request.resource.data)
        || (
          request.resource.data.lastMessageAt is string
          || request.resource.data.lastMessageAt is timestamp
        )
      )

      && (
        !("lastSender" in request.resource.data)
        || request.resource.data.lastSender == "customer"
      )

      && (
        !("updatedAt" in request.resource.data)
        || (
          request.resource.data.updatedAt is string
          || request.resource.data.updatedAt is timestamp
        )
      )

      && (
        !("adminNotified" in request.resource.data)
        || request.resource.data.adminNotified is bool
      );
    }

    function validContactChatMessageCreate(messageId) {
      let parent = getAfter(/databases/$(database)/documents/contact_messages/$(messageId)).data;

      return request.resource.data.keys().hasAll([
        "text",
        "sender",
        "createdAt",
        "read"
      ])

      && request.resource.data.keys().hasOnly([
        "text",
        "sender",
        "createdAt",
        "read"
      ])

      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 3000

      && request.resource.data.sender in ["customer", "admin"]

      && (
        request.resource.data.createdAt is string
        || request.resource.data.createdAt is timestamp
      )

      && request.resource.data.read is bool

      && (
        (isActiveAdmin() && request.resource.data.sender == "admin")
        || (
          isSignedIn()
          && parent.customerUid is string
          && parent.customerUid == request.auth.uid
          && request.resource.data.sender == "customer"
        )
        || (
          !isSignedIn()
          && !("customerUid" in parent)
          && request.resource.data.sender == "customer"
        )
      );
    }

    function validProductReviewCreate() {
      let data = request.resource.data;

      return data.keys().hasAll([
        "productId",
        "productSlug",
        "productTitle",
        "fullName",
        "rating",
        "comment",
        "status",
        "createdAt",
        "updatedAt"
      ])

      && data.keys().hasOnly([
        "productId",
        "productSlug",
        "productTitle",
        "fullName",
        "rating",
        "comment",
        "status",
        "sourcePage",
        "createdAt",
        "updatedAt"
      ])

      && data.productId is string
      && data.productId.size() > 0

      && data.productSlug is string
      && data.productSlug.size() > 0

      && data.productTitle is string
      && data.productTitle.size() > 0

      && data.fullName is string
      && data.fullName.size() >= 2
      && data.fullName.size() <= 100

      && data.rating is int
      && data.rating >= 1
      && data.rating <= 5

      && data.comment is string
      && data.comment.size() > 0
      && data.comment.size() <= 1200

      && data.status == "pending"

      && (
        !("sourcePage" in data)
        || (
          data.sourcePage is string
          && data.sourcePage.size() <= 200
        )
      )

      && data.createdAt is string
      && data.createdAt.size() <= 40

      && data.updatedAt is string
      && data.updatedAt.size() <= 40

      && data.createdAt == data.updatedAt;
    }

    function validProductReviewAdminUpdate() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(["status", "adminNote", "updatedAt"])

      && request.resource.data.status in ["pending", "approved", "rejected"]

      && (
        !("adminNote" in request.resource.data)
        || (
          request.resource.data.adminNote is string
          && request.resource.data.adminNote.size() <= 1000
        )
      )

      && request.resource.data.updatedAt is string
      && request.resource.data.updatedAt.size() <= 40;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isManagerAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isManagerAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isManagerAdmin();
    }

    match /homepage/{documentId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    match /about/{documentId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    match /site_settings/{documentId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    match /legal_pages/{documentId} {
      allow read: if true;
      allow create, update: if isActiveAdmin();
      allow delete: if isSuperAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if validContactMessageCreate();
      allow get, list: if isActiveAdmin() || (
        isSignedIn()
        && resource.data.customerUid is string
        && resource.data.customerUid == request.auth.uid
      );
      allow update: if (
        isActiveAdmin() && validContactMessageAdminUpdate()
      ) || validContactMessageCustomerUpdate();
      allow delete: if isManagerAdmin();

      match /messages/{chatMessageId} {
        allow create: if validContactChatMessageCreate(messageId);

        allow get, list: if isActiveAdmin() || (
          isSignedIn()
          && get(/databases/$(database)/documents/contact_messages/$(messageId)).data.customerUid is string
          && get(/databases/$(database)/documents/contact_messages/$(messageId)).data.customerUid == request.auth.uid
        );

        allow update: if (
          isActiveAdmin()
          || (
            isSignedIn()
            && get(/databases/$(database)/documents/contact_messages/$(messageId)).data.customerUid is string
            && get(/databases/$(database)/documents/contact_messages/$(messageId)).data.customerUid == request.auth.uid
          )
        )
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["read"])
        && request.resource.data.read is bool;

        allow delete: if isManagerAdmin();
      }
    }

    match /product_reviews/{reviewId} {
      allow create: if validProductReviewCreate();
      allow get, list: if isActiveAdmin() || resource.data.status == "approved";
      allow update: if isActiveAdmin() && validProductReviewAdminUpdate();
      allow delete: if isManagerAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && (
        request.auth.uid == adminId || isSuperAdmin()
      );

      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin() && validAdminDocument(adminId);

      allow update: if (
        isSuperAdmin() && validAdminDocument(adminId)
      ) || (
        isSignedIn()
        && request.auth.uid == adminId
        && resource.data.status == "active"
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(["lastLoginAt", "updatedAt"])
        && validAdminDocument(adminId)
      );

      allow delete: if isSuperAdmin() && request.auth.uid != adminId;
    }

    match /mail/{mailId} {
      allow create: if (
        isActiveAdmin()
        || (
          isSignedIn()
          && request.resource.data.source == "customer_chat_first_message"
          && ("chatId" in request.resource.data)
          && request.resource.data.chatId is string
          && get(/databases/$(database)/documents/contact_messages/$(request.resource.data.chatId)).data.customerUid is string
          && get(/databases/$(database)/documents/contact_messages/$(request.resource.data.chatId)).data.customerUid == request.auth.uid
        )
      )
      && request.resource.data.keys().hasAll(["to", "message"])
      && request.resource.data.keys().hasOnly([
        "to",
        "message",
        "createdAt",
        "source",
        "chatId",
        "metadata"
      ])
      && request.resource.data.to is list
      && request.resource.data.to.size() > 0
      && request.resource.data.to.size() <= 5
      && request.resource.data.message is map
      && request.resource.data.message.subject is string
      && request.resource.data.message.subject.size() > 0
      && request.resource.data.message.subject.size() <= 180
      && request.resource.data.message.html is string
      && request.resource.data.message.html.size() > 0
      && request.resource.data.message.html.size() <= 20000
      && (
        !("createdAt" in request.resource.data)
        || (
          request.resource.data.createdAt is string
          || request.resource.data.createdAt is timestamp
        )
      )
      && (
        !("chatId" in request.resource.data)
        || request.resource.data.chatId is string
      )
      && (
        !("source" in request.resource.data)
        || request.resource.data.source is string
      );

      allow read, update, delete: if false;
    }

    match /email_verifications/{verificationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
